# Deployer wallet (same key works on any EVM testnet — fund each network separately)
DEPLOYER_PRIVATE_KEY=

# Pick ONE network, set its RPC, then: npm run deploy:sepolia (etc.)

# Ethereum Sepolia (recommended if Polygon RPC is blocked)
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Polygon Amoy
POLYGON_AMOY_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com

# Base Sepolia (alternative)
BASE_SEPOLIA_RPC_URL=https://base-sepolia-rpc.publicnode.com

# Optional: Alchemy/Infura URLs often work on restricted networks (replace YOUR_KEY)
# SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY